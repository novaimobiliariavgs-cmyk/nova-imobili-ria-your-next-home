{
  "redirects": [
    {
      "source": "/imoveis",
      "has": [
        {
          "type": "query",
          "key": "finalidade",
          "value": "aluguel"
        }
      ],
      "destination": "/casas-para-alugar-vargem-grande-do-sul",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/imoveis",
      "has": [
        {
          "type": "query",
          "key": "finalidade",
          "value": "venda"
        }
      ],
      "destination": "/_pre/imoveis-venda/index.html"
    },
    {
      "source": "/imoveis",
      "destination": "/_pre/imoveis-todos/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/_spa.html"
    }
  ]
}
